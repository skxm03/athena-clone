{
	"name": "athena5",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "app/app.js",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"electron": "electron ./app/app.js",
		"dist:mac": "npm run build && electron-builder --mac dmg"
	},
	"build": {
		"appId": "com.athena5.app",
		"productName": "Athena",
		"directories": {
			"output": "dist"
		},
		"files": [
			"app/**/*",
			"dist/**/*",
			"package.json",
			"!node_modules/.cache/**/*"
		],
		"mac": {
			"target": [
				"dmg"
			],
			"category": "public.app-category.productivity"
		}
	}
}
